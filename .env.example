# Server
PORT=4100
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Mongo
MONGO_URI=mongodb://localhost:27017/realtime_chat

# Redis
# NOTE: host port 6380 (not the default 6379) — see docker-compose.yml. This project's
# machine may already have another Redis container bound to 6379; 6380 avoids the clash.
REDIS_URL=redis://localhost:6380

# Auth
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Web Push (generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:admin@example.com

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=15

# Client (Vite - must be prefixed VITE_)
VITE_API_URL=http://localhost:4100
VITE_SOCKET_URL=http://localhost:4100
VITE_VAPID_PUBLIC_KEY=
